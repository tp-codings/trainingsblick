# Python-Umgebung (legt "Trainingsblick starten.cmd" beim ersten Start an)
.venv/
__pycache__/
*.pyc

# Oberfläche: Pakete zum Bauen (web/index.html ist der fertige Build und gehört ins Repo)
ui/node_modules/

# Eigene Daten liegen nicht hier, sondern in %APPDATA%\Trainingsblick; zur Sicherheit trotzdem ausschließen
config/
.cache/
*.secrets.json
*.mp3

# Installer: Zwischenstand und heruntergeladenes Python (installer/bauen.ps1)
installer/build/
installer/cache/

# Eigene Hilfsskripte (z. B. Reel-Aufnahme), nicht Teil des Programms
tools/

# macOS: Starter, den "Trainingsblick starten.command" beim ersten Start baut (installer/mac_app.py)
Trainingsblick.app/
.DS_Store
